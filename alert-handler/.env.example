# Kafka
SMART_GRID_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SMART_GRID_ALERTS_TOPIC=ST2
SMART_GRID_ALERT_HANDLER_GROUP_ID=alert-handler
SMART_GRID_KAFKA_POLL_TIMEOUT_MS=1000

# HTTP
SMART_GRID_ALERT_HANDLER_HOST=0.0.0.0
SMART_GRID_ALERT_HANDLER_PORT=8082

# Local files
SMART_GRID_NOTIFICATIONS_PATH=data/notifications/emails.log

# PostgreSQL alert storage
SMART_GRID_POSTGRES_URL=jdbc:postgresql://localhost:5432/smartgrid
SMART_GRID_POSTGRES_USER=smartgrid
SMART_GRID_POSTGRES_PASSWORD=smartgrid

# Mail
SMART_GRID_MAIL_MODE=smtp
SMART_GRID_MAIL_FROM=alerts@example.com
SMART_GRID_MAIL_TO=operator@example.com,maintenance@example.com
SMART_GRID_MAIL_RECIPIENTS_PATH=data/config/mail-recipients.txt

# SMTP
SMART_GRID_SMTP_HOST=smtp.example.com
SMART_GRID_SMTP_PORT=587
SMART_GRID_SMTP_USERNAME=alerts@example.com
SMART_GRID_SMTP_PASSWORD=change-me
SMART_GRID_SMTP_AUTH=true
SMART_GRID_SMTP_START_TLS=true
SMART_GRID_SMTP_SSL=false
SMART_GRID_SMTP_CONNECTION_TIMEOUT_MS=10000
SMART_GRID_SMTP_TIMEOUT_MS=10000
